{
  "name": "wfh-lounge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-stillroom \"node --test tests/\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "dev:emulators": "VITE_USE_EMULATORS=1 vite --port 5174",
    "emulators": "firebase emulators:start --only auth,firestore --project wfh-lounge",
    "test:e2e": "node tests/e2e/seed.mjs && node tests/e2e/app.e2e.mjs && node tests/e2e/seed.mjs && node tests/e2e/signup.e2e.mjs"
  },
  "dependencies": {
    "firebase": "^10.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@vitejs/plugin-react": "^4.3.1",
    "firebase-tools": "^13.35.1",
    "vite": "^5.4.0"
  }
}
